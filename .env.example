# Copy this file to .env and fill in real values. Never commit the real .env.

# --- n8n ---
N8N_USER=eric_admin
N8N_PASSWORD=changeme_use_a_real_password
N8N_HOST=your-app-name.onrender.com
N8N_ENCRYPTION_KEY=generate_a_random_32_char_string
TIMEZONE=Africa/Lagos

# --- Telegram ---
# Get this from @BotFather on Telegram after creating "Eric"
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Hugging Face ---
# Free Inference API token from huggingface.co/settings/tokens
HUGGINGFACE_API_TOKEN=

# --- GitHub ---
# Personal access token with repo scope
GITHUB_TOKEN=
GITHUB_USERNAME=
GITHUB_REPO=

# --- Vercel ---
VERCEL_TOKEN=

# --- LinkedIn ---
# Requires LinkedIn Developer app + OAuth2 (LinkedIn does NOT have a free
# unrestricted posting API — see notes in SETUP.md)
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_PERSON_URN=

# --- Zapier ---
# The "Catch Hook" webhook URL from your Zap's trigger step
ZAPIER_WEBHOOK_URL=

# --- Lovable web app ---
# The shared secret the Lovable app sends so n8n knows it's really you
LOVABLE_SHARED_SECRET=
